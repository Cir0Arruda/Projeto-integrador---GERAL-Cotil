# ─── EVAH OPHIM — Environment Variables ───

# Server
PORT=3000
HOST=127.0.0.1
# Enable only behind the configured local reverse proxy while bound to loopback.
TRUST_PROXY_LOOPBACK=false
# Trusted fixed analytics runners only; never enables arbitrary code or file imports.
# Requires analytics_schema.sql provisioned by the migration account and Node 24+.
ANALYTICS_TRUSTED_RUNNER=false
# CSV/JSON imports require a separate Linux container parser; no host fallback.
# Pin an approved official Node 24+ image digest, pre-pull it, then validate isolation.
ANALYTICS_FILE_IMPORTS=false
ANALYTICS_PARSER_IMAGE=
ANALYTICS_DOCKER_PATH=docker

# MySQL - configuration only for the API process on the VPS, never for clients.
DB_TOPOLOGY=vps-local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=astha_runtime
DB_PASSWORD=
DB_NAME=astha_raven_prod
# SQL stays on private loopback. Retired COTIL destinations are rejected.
DB_SSL_REQUIRED=false
DB_SSL_CA_FILE=
# Explicit platform support identities; tenant admins have no global contact access.
SUPPORT_ADMIN_IDENTITIES=[]

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Optional verified OAuth providers
GOOGLE_CLIENT_ID=

# E-mail transacional opcional. Somente no servidor; nunca colocar no Flutter.
# Desativado até configurar provedor/remetente e autorizar os testes reais.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# Porta 587 exige STARTTLS; 465 usa TLS imediato. Certificado sempre validado.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Browser origins allowed by CORS (comma-separated; never use *)
ALLOWED_ORIGINS=https://136.111.89.192,http://localhost:7357,http://127.0.0.1:7357

# Assistente operacional (servidor apenas)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
